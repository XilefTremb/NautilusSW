      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="base_link_to_thruster6_base_link_joint" type="fixed">
    <parent link="base_link"/>
    <child link="thruster6_base_link"/>
    <origin rpy="3.1415926 0 0" xyz="0 0.105 0"/>
  </joint>
  <link name="thruster6_thruster">
    <visual name="cil">
      <geometry>
        <cylinder length="0.02" radius="0.0485"/>
      </geometry>
    </visual>
    <inertial>
      <mass value="0.00001"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="thruster6_thruster_joint" type="fixed">
    <parent link="thruster6_base_link"/>
    <child link="thruster6_thruster"/>
    <origin xyz="0.0485 0 0"/>
  </joint>
  <link name="thruster6_propeler">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <visual name="blade1">
      <origin rpy="0.78 0.0 0.0" xyz="0.01125 0. 0."/>
      <geometry>
        <box size="0.0225 0.01  0.005"/>
      </geometry>
    </visual>
    <visual name="blade2">
      <origin rpy="0.78 0 0" xyz="-0.01125 0.0 0.0"/>
      <geometry>
        <box size="0.0225 0.01  0.005"/>
      </geometry>
    </visual>
    <!--<visual name='${name}_propeler_visual'>
        <origin xyz="-0.032 -0.025 -0.00 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://meshes/Propeller.STL"/>  
        </geometry>
      </visual>-->
  </link>
  <joint name="thruster6_propeler_joint" type="continuous">
    <parent link="thruster6_thruster"/>
    <child link="thruster6_propeler"/>
    <origin xyz="0 0 -0.025"/>
    <axis xyz="0 0 1"/>
    <!--<limit effort="1000.0" velocity="0.200"/>-->
    <dynamics damping="0.01" friction="0.01"/>
  </joint>
  <gazebo>
    <!--plugin name="${name}_propeller_plugin" filename="libLiftDragPlugin.so">
        <a0>0.3</a0>
        <alpha_stall>1.4</alpha_stall>
        <cla>4.2500</cla>
        <cda>0.10</cda>
        <cma>0.00</cma>
        <cla_stall>-0.025</cla_stall>
        <cda_stall>0.0</cda_stall>
        <cma_stall>0.0</cma_stall>
        <area>0.002</area>
        <air_density>1000</air_density>
        <cp>-0.084 0 0</cp>
        <forward>0 -1 0</forward>
        <upward>0 0 -1</upward>
        <link_name>${name}_propeler</link_name>
      </plugin-->
  </gazebo>
  <allow_auto_disable>1</allow_auto_disable>
  <gazebo>
    <plugin filename="libArduPilotPlugin.so" name="ArduPilotPlugin">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <fdm_port_out>9003</fdm_port_out>
      <imuName>base_link_imu_sensor</imuName>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <!--
            incoming control command [0, 1]
            so offset it by -0.5 to get [-0.5, 0.5].
            multiplier = 102
            Positive thrust = 51
            Negative thrust = -41
        -->
      <control channel="0">
        <type>VELOCITY</type>
        <offset>-0.5</offset>
        <p_gain>1</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>0.5</cmd_max>
        <cmd_min>-0.5</cmd_min>
        <jointName>thruster1_propeler_joint</jointName>
        <multiplier>102</multiplier>
      </control>
      <control channel="1">
        <type>VELOCITY</type>
        <offset>-0.5</offset>
        <p_gain>1</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>0.5</cmd_max>
        <cmd_min>-0.5</cmd_min>
        <jointName>thruster2_propeler_joint</jointName>
        <multiplier>102</multiplier>
      </control>
      <control channel="2">
        <type>VELOCITY</type>
        <offset>-0.5</offset>
        <p_gain>1</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>0.5</cmd_max>
        <cmd_min>-0.5</cmd_min>
        <jointName>thruster3_propeler_joint</jointName>
        <multiplier>102</multiplier>
      </control>
      <control channel="3">
        <type>VELOCITY</type>
        <offset>-0.5</offset>
        <p_gain>1</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>0.5</cmd_max>
        <cmd_min>-0.5</cmd_min>
        <jointName>thruster4_propeler_joint</jointName>
        <multiplier>102</multiplier>
      </control>
      <control channel="4">
        <type>VELOCITY</type>
        <offset>-0.5</offset>
        <p_gain>1</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>0.5</cmd_max>
        <cmd_min>-0.5</cmd_min>
        <jointName>thruster5_propeler_joint</jointName>
        <multiplier>102</multiplier>
      </control>
      <control channel="5">
        <type>VELOCITY</type>
        <offset>-0.5</offset>
        <p_gain>1</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>0.5</cmd_max>
        <cmd_min>-0.5</cmd_min>
        <jointName>thruster6_propeler_joint</jointName>
        <multiplier>102</multiplier>
      </control>
    </plugin>
