<?xml version='1.0'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="Camera">

  <xacro:macro name="CameraDepth" params="name link xyz rpy">

    <!--    set property   -->
    <xacro:property name="xyzFrameCam" value="0 0 0" />
    <xacro:property name="rpyFrameCam" value="0 0 0" />


    <!--    define link  -->
    <link name="${name}_camera_link">
        <visual>
            <geometry>
                <box size="0.025 0.025 0.025"/>
            </geometry>
        </visual>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.0035"/>
            <inertia
            ixx="1"
            ixy="0"
            ixz="0"
            iyy="1"
            iyz="0"
            izz="1"/>
        </inertial>

    </link>

    <gazebo reference="${name}_camera_link">
        <material>Gazebo/Black</material>
    </gazebo>

    <joint name="${name}_camera_joint" type="fixed">
        <parent link="${link}"/>
        <child link="${name}_camera_link"/>
        <origin rpy="${rpy}" xyz="${xyz}"/>
        <axis xyz="1 0 0" />
    </joint>

    <gazebo reference="${name}_camera_joint">
        <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <link name="${name}_camera_frame">
        <visual>
            <geometry>
                <box size="0.005 0.01 0.01"/>
            </geometry>

        </visual>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.0035"/>
            <inertia
            ixx="1"
            ixy="0"
            ixz="0"
            iyy="1"
            iyz="0"
            izz="1"/>
        </inertial>

    </link>

    <joint name="${name}_camera_frame_joint" type="fixed">
        <parent link="${name}_camera_link"/>
        <child link="${name}_camera_frame"/>
       
        <origin rpy="${rpyFrameCam}" xyz="${xyzFrameCam}"/>
        
    </joint>

    <gazebo reference="${name}_camera_frame_joint">
        <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>


    <link name="${name}_camera_depth_optical_frame">
            
        <inertial>
            <origin xyz="0 0.069 -0.047" rpy="0 0 0"/>
            <mass value="0.035"/>
            <inertia
            ixx="1"
            ixy="0"
            ixz="0"
            iyy="1"
            iyz="0"
            izz="1"/>
        </inertial>

    </link>

    <joint name="${name}_camera_depth_optical_joint" type="fixed">
            <parent link="${name}_camera_frame"/>
            <child link="${name}_camera_depth_optical_frame"/>
            
            <origin rpy="${-pi/2} 0 ${-pi/2}" xyz="0 0 0"/>
            <axis xyz="0 0 1" />
    </joint>


    <gazebo reference="${name}_camera_depth_optical_joint">
        <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>


    <!-- camera -->
    <gazebo reference="${name}_camera_frame">
        <sensor type="depth_camera" name="${name}_depth_sensor">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>10.0</update_rate>
        <topic>camera/depth/image_raw</topic>
        <gz_frame_id>camera_depth_frame</gz_frame_id>
        <camera name="head">
        <!-- https://elinux.com/Rpi_Camera_Module  -->
            <horizontal_fov>1.0855</horizontal_fov>
            <!-- vertical_fov>0.85169</vertical_fov -->
            <image>
            <width>1920</width>
            <height>1080</height>
            <format>B8G8R8</format>
            </image>
            <clip>
            <near>0.01</near>
            <far>500</far>
            </clip>
            <min_depth>0.1</min_depth>
            <max_depth>50.0</max_depth>
            <noise>
            <type>gaussian</type>
            <!-- Noise is sampled independently per pixel on each frame.
                That pixel's noise value is added to each of its color
                channels, which at that point lie in the range [0,1]. -->
            <mean>0.0</mean>
            <stddev>0.007</stddev>
            </noise>
        </camera>
        <depth_camera>
        <clip>
          <near>0.1</near>
          <far>50.0</far>
        </clip>
      </depth_camera>
            <!-- <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
            <frame_name>${name}_camera_rgb_optical_frame</frame_name>
                <alwaysOn>true</alwaysOn>
                <visualize>true</visualize>
                <updateRate>30.0</updateRate>
                <cameraName>camera</cameraName>
                <imageTopicName>image_raw</imageTopicName>
                <cameraInfoTopicName>camera_info</cameraInfoTopicName>
                <frame_Name>${name}_camera_frame_joint</frame_Name>
                <hackBaseline>0.07</hackBaseline>
                <distortionK1>0.0</distortionK1>
                <distortionK2>0.0</distortionK2>
                <distortionK3>0.0</distortionK3>
                <distortionT1>0.0</distortionT1>
                <distortionT2>0.0</distortionT2>
            </plugin> -->
            
        </sensor>
    </gazebo>
    
  </xacro:macro>
  
</robot>