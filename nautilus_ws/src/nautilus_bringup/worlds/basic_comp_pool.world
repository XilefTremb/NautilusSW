    </model>
    <model name='lane_marker_4'>
      <static>1</static>
      <pose>2 -0.5 -2.134 0 0 0</pose>
      <link name='lane_marker_4_link'>
        <visual name='lane_marker_4_visual'>
          <geometry>
            <box>
              <size>24.4 0.2 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
