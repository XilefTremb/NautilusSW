    <!-- Wall East (x=14.5) -->
    <model name='wall_east'>
      <static>1</static>
      <pose>14.5 -3 -1.065 0 0 0</pose>
      <link name='wall_east_link'>
        <collision name='wall_east_collision'>
          <geometry>
            <box>
              <size>0.3 25 2.13</size>
            </box>
          </geometry>
          <max_contacts>10</max_contacts>
          <surface>
            <friction>
              <ode>
                <mu>0.5</mu>
