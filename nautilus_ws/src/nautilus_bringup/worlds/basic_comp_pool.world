        <kinematic>0</kinematic>
      </link>
    </model>
    

    
    <!-- **** 2 × GATE + BUOY **** -->
    <include>
      <uri>model://robosub_gate</uri>
      <name>robosub_gate_1</name>
      <pose>-5 4 -1.5 0 0 0.4</pose>
    </include>
    <include>
      <uri>model://robosub_gate</uri>
      <name>robosub_gate_5</name>
      <pose>-5 -7 -1.5 0 0 0</pose>
    </include>
    <include>
      <uri>model://robosub_gate_leg</uri>
      <name>robosub_gate_leg</name>
      <pose>10 -7 -0.5 0 0 0</pose>
    </include>


    <!-- **** 1 × TORPEDO TARGET **** -->
    <include>
      <uri>model://robosub_torpedo</uri>
      <name>robosub_torpedo_1</name>
      <pose>7 1.75 -2 1.57 0 2.94159</pose>
    </include>


    <!-- **** 1 × BIN **** -->
    <include>
      <uri>model://robosub_bin</uri>
      <name>robosub_bin_1</name>
      <pose>7 6.0 -1.9 1.57 0 0</pose>
    </include>


    <!-- **** 1 × OCTAGON **** -->
    <include>
      <uri>model://robosub_octagon</uri>
      <name>robosub_octagon_1</name>
      <pose>11 3.5 -1.97 0 0 0</pose>
    </include>


    <!-- SLALOM PIPES -->
    <include>
      <uri>model://robosub_slalom</uri>
      <name>robosub_slalom_1_1</name>
      <pose>-0.75 3.75 -1.35 0 0 1.57</pose>
    </include>
    <include>
      <uri>model://robosub_slalom</uri>
      <name>robosub_slalom_1_2</name>
      <pose>0.75 4.5 -1.35 0 0 1.57</pose>
    </include>
    <include>
      <uri>model://robosub_slalom</uri>
      <name>robosub_slalom_1_3</name>
      <pose>2.25 3.75 -1.35 0 0 1.57</pose>
    </include>

    
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>-1.83265 9.56062 12.0698 0 0.603644 -1.51579</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
  </world>
</sdf>
