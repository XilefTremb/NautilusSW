<?xml version='1.0'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="DepthSensor">

  <xacro:macro name="DepthSensor" params="parent_link sensor_name">

    <gazebo reference="${parent_link}">
      <sensor name="${sensor_name}" type="air_pressure">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <pose>0 0 0 0 0 0</pose>
        <topic>/${sensor_name}</topic>
      </sensor>
    </gazebo>
    
  </xacro:macro>
  
</robot>
